<Mod id="dc718a43-7f42-45c5-8963-a158d69d947b" version="4">
  <Properties>
    <Name>Eclipse</Name>
    <Stability>Alpha</Stability>
    <Teaser>Small mod to give Beyond Earth more flavour</Teaser>
    <Description>Small changes to leaders, victories, and affinities to make them more interesting</Description>
