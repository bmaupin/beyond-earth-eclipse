  <Actions>
    <OnModActivated>
      <!-- This will need to happen first since changes to civilisations depends on this -->
      <UpdateDatabase>SQL/Technologies.sql</UpdateDatabase>
      <UpdateDatabase>SQL/Builds.sql</UpdateDatabase>
      <UpdateDatabase>SQL/Civilizations.sql</UpdateDatabase>
      <UpdateDatabase>SQL/HandicapInfos.sql</UpdateDatabase>
      <UpdateDatabase>SQL/Language_en_US.sql</UpdateDatabase>
      <UpdateDatabase>SQL/Leaders.sql</UpdateDatabase>
      <UpdateDatabase>SQL/Projects.sql</UpdateDatabase>
      <UpdateDatabase>SQL/Quests.sql</UpdateDatabase>
      <UpdateDatabase>SQL/Units.sql</UpdateDatabase>
      <UpdateDatabase>XML/Leader_CondemnationBiases.xml</UpdateDatabase>
      <UpdateDatabase>XML/Leader_Flavors.xml</UpdateDatabase>
      <UpdateDatabase>XML/Leader_MajorCivApproachBiases.xml</UpdateDatabase>
      <UpdateDatabase>XML/Leaders.xml</UpdateDatabase>
    </OnModActivated>
  </Actions>
  <EntryPoints>
    <!-- To make the game load custom Quests, you have to import them into the VFS, and Load them via the Content Tab as Type: Quest and Name: <Name of the File without the .lua Ending>.
         (https://forums.civfanatics.com/threads/what-would-be-the-simplest-way-to-replace-a-required-building-for-a-quest.623436/#post-14894202)  -->
